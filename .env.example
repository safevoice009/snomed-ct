# Supabase Credentials (optional for fallback mode, required for cloud lookup)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# LiteLLM Configuration (required for Hinglish clinical text translation)
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini/gemini-1.5-flash

# API security keys (comma separated list of accepted keys for API B2B access)
API_KEYS=test-dev-key,prod-emr-key1,prod-emr-key2
