# Dockerfile.onprem - SICCE Air-Gapped DPDP Enterprise Appliance
# Zero-Cloud Egress On-Premises Clinical AI & ABDM Gateway

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    SICCE_DEPLOYMENT_MODE=ON_PREMISE_AIR_GAPPED \
    DPDP_LOCAL_COMPLIANCE=STRICT

# Install minimal OS dependencies for high-speed offline FTS5 & imaging
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libsqlite3-dev \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy local application code & pre-compiled SQLite clinical terminology graph
COPY . .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
